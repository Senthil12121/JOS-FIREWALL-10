<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Top spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- App Logo and Header -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="JOS Firewall Shield"
        android:src="@drawable/ic_shield_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="JOS FIREWALL"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_instruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Enter Security Passcode to Unlock"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- PIN Dots Container (Visible in PIN mode) -->
    <LinearLayout
        android:id="@+id/layout_pin_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:id="@+id/dot_1"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/ic_check"
            android:backgroundTint="@color/surface_stroke" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/ic_check"
            android:backgroundTint="@color/surface_stroke" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/ic_check"
            android:backgroundTint="@color/surface_stroke" />

        <View
            android:id="@+id/dot_4"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/ic_check"
            android:backgroundTint="@color/surface_stroke" />
    </LinearLayout>

    <!-- Alphanumeric Password Input (Visible in text password mode) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_password_input"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        app:boxStrokeColor="@color/primary"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Password"
            android:inputType="textPassword"
            android:textColor="@color/text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/tv_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Incorrect passcode. Try again."
        android:textColor="@color/error"
        android:textSize="13sp"
        android:visibility="invisible" />

    <!-- Center spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Numeric Keypad Grid -->
    <GridLayout
        android:id="@+id/grid_keypad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="4">

        <Button
            android:id="@+id/btn_key_1"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="1"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <Button
            android:id="@+id/btn_key_2"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="2"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <Button
            android:id="@+id/btn_key_3"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="3"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <Button
            android:id="@+id/btn_key_4"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="4"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <Button
            android:id="@+id/btn_key_5"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="5"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <Button
            android:id="@+id/btn_key_6"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="6"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <Button
            android:id="@+id/btn_key_7"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="7"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <Button
            android:id="@+id/btn_key_8"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="8"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <Button
            android:id="@+id/btn_key_9"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="9"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <ImageButton
            android:id="@+id/btn_key_biometric"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Biometric unlock"
            android:src="@drawable/ic_shield_logo"
            app:tint="@color/primary" />

        <Button
            android:id="@+id/btn_key_0"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:text="0"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            app:backgroundTint="@color/surface" />

        <ImageButton
            android:id="@+id/btn_key_backspace"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete key"
            android:src="@drawable/ic_block"
            app:tint="@color/text_secondary" />
    </GridLayout>

    <!-- Submit button for password mode -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_unlock_password"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Unlock Firewall"
        android:visibility="gone"
        app:cornerRadius="12dp" />

    <!-- Bottom Actions -->
    <TextView
        android:id="@+id/tv_forgot_passcode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:padding="8dp"
        android:text="Forgot Passcode?"
        android:textColor="@color/text_tertiary"
        android:textSize="12sp" />

</LinearLayout>
